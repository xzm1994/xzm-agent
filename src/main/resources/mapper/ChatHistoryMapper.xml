<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.xzmagent.repository.ChatHistoryMapper">

    <select id="listLatest" resultType="com.example.xzmagent.domain.ChatHistoryDO">
        SELECT conversation_id,message_json
        FROM chat_history
        WHERE conversation_id = #{conversationId}
        ORDER BY id DESC
            LIMIT #{lastN}
    </select>

    <delete id="deleteByConversationId">
        DELETE FROM chat_history WHERE conversation_id = #{conversationId}
    </delete>

</mapper>
